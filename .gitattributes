# 服务器脚本和 systemd 单元必须是 LF，CRLF 会让 Linux 报 command not found（见 L07）
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.py        text eol=lf
Caddyfile*  text eol=lf
*.ps1       text eol=crlf

# Preserve upstream vendored bytes; their formatting is not maintained here.
app/static/vendor/** -whitespace

# Unified diffs require single-space context lines, including empty lines.
ops/studio-runtime-repairs/**/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
