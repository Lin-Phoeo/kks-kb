<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == ''">$(MSBuildProgramFiles32)/Reference Assemblies/Microsoft/Framework/.NETFramework/v4.7.2</FrameworkPathOverride><LangVersion>7.3</LangVersion>
    <AssemblyName>Codex.StudioConfigLocalization</AssemblyName><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>


  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TranslationCatalog.cs"/><Compile Include="DisplayState.cs"/><Compile Include="StudioConfigLocalization.cs"/>
    <Reference Include="BepInEx" HintPath="$(GameRoot)/BepInEx/core/BepInEx.dll" Private="false"/>
    <Reference Include="0Harmony" HintPath="$(GameRoot)/BepInEx/core/0Harmony.dll" Private="false"/>
    <Reference Include="ConfigurationManager" HintPath="$(GameRoot)/BepInEx/plugins/ConfigurationManager/ConfigurationManager.dll" Private="false"/>
    <Reference Include="Newtonsoft.Json" HintPath="$(GameRoot)/BepInEx/plugins/Newtonsoft.Json.dll" Private="false"/>
    <Reference Include="UnityEngine" HintPath="$(GameRoot)/CharaStudio_Data/Managed/UnityEngine.dll" Private="false"/>
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameRoot)/CharaStudio_Data/Managed/UnityEngine.CoreModule.dll" Private="false"/>
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameRoot)/CharaStudio_Data/Managed/UnityEngine.IMGUIModule.dll" Private="false"/>
  </ItemGroup>
  <Target Name="HostReferences" AfterTargets="ResolveAssemblyReferences"><ItemGroup><ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"/></ItemGroup></Target>
</Project>
