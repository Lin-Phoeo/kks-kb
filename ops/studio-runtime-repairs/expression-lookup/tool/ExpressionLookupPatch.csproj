<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath><Private>true</Private></Reference></ItemGroup>
  <Target Name="RequireLocalCecil" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(CecilPath)')" Text="Pass -p:CecilPath with your existing Mono.Cecil.dll path." /></Target>
</Project>
