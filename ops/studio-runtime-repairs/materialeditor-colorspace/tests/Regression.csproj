<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TestTargetFramework)</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(Mode)' == 'baseline'">BASELINE</DefineConstants>
    <AssemblyName>$(Mode)-regression</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FakeRuntime.cs" />
    <Compile Include="ManagedRegression.cs" />
    <Compile Include="LegacyDecodeFixture.cs" Condition="'$(Mode)' == 'baseline'" />
    <Compile Include="../MEColorSpaceFixPlugin.cs" Condition="'$(Mode)' == 'candidate'" />
  </ItemGroup>
  <Target Name="RequireTestTarget" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TestTargetFramework)' == ''" Text="Use run-managed-regression.ps1 or set TestTargetFramework to an installed SDK target." />
  </Target>
</Project>
