<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath><Private>true</Private></Reference></ItemGroup>
  <Target Name="RequireCecil" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(CecilPath)')" Text="Pass -p:CecilPath=&lt;path-to-your-existing-Mono.Cecil.dll&gt;" /></Target>
</Project>
