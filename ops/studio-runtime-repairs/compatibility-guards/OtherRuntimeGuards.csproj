<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PatchOtherRuntimeGuards.cs" />
    <Compile Include="GuardPatches.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CecilPath)' == '' Or !Exists('$(CecilPath)')" Text="Set CecilPath to the local Mono.Cecil DLL from BepInEx/core. No third-party DLL is distributed here." />
  </Target>
</Project>
