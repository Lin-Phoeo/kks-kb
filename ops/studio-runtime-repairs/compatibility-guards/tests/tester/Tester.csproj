<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /><Compile Include="../../GuardPatches.cs" /><Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath><Private>true</Private></Reference></ItemGroup>
  <Target Name="RequireCecilPath" BeforeTargets="ResolveReferences"><Error Condition="'$(CecilPath)' == '' Or !Exists('$(CecilPath)')" Text="Set CecilPath to local Mono.Cecil.dll." /></Target>
</Project>
