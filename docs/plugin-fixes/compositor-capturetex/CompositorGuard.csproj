<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CompositorGuard</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(CecilPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CecilPath)' == '' Or !Exists('$(CecilPath)')" Text="Set CecilPath to a local Mono.Cecil 0.10.4 DLL; no dependency DLL is distributed here." />
  </Target>
</Project>
